# Discord application and guild. Enable the Message Content privileged intent in the Developer Portal.
#
# The four channel and category ids below are optional: leave the placeholders and Heimdall
# creates each one on first run and remembers it. Recommended afterwards - copy the ids it
# reports ("Created open tickets category (...) and stored it for future runs") into this file,
# so the layout is pinned somewhere you can read rather than only in the database. An id set
# here must exist: Heimdall refuses to start rather than quietly creating a second one.
DISCORD_TOKEN=replace_with_bot_token
DISCORD_GUILD_ID=replace_with_guild_id
DISCORD_ADMIN_ROLE_ID=replace_with_admin_role_id
DISCORD_MODERATOR_ROLE_ID=replace_with_moderator_role_id
DISCORD_GM_ROLE_ID=replace_with_game_master_role_id
#
# There is deliberately no DISCORD_BOT_ROLE_ID here. Discord creates one managed role per
# application and that is the only role a bot is ever in - you cannot make one and add the
# bot to it. Heimdall finds its own. Set DISCORD_BOT_ROLE_ID only if you must override it,
# and only to the id of that managed role.
#
# The name of the category Heimdall puts its own channels in. Optional.
DISCORD_SUPPORT_CATEGORY_NAME=Heimdall Support
DISCORD_PANEL_CHANNEL_ID=replace_with_open_ticket_channel_id
DISCORD_OPEN_CATEGORY_ID=replace_with_open_ticket_category_id
DISCORD_CLAIMED_CATEGORY_ID=replace_with_claimed_ticket_category_id
DISCORD_CLOSED_CATEGORY_ID=replace_with_closed_ticket_category_id
DISCORD_SUPPORT_CATEGORY_ID=replace_with_support_category_id
DISCORD_QUEUE_CHANNEL_ID=replace_with_queue_channel_id

# The gm-command-audit channel, and both things that write to it. On unless set to 0.
COMMAND_AUDIT_CHANNEL=1

# This bot account is restricted to heimdall_* tables only.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=characters_database_name
MYSQL_USER=heimdall_bot
MYSQL_PASSWORD=replace_with_database_password

# Existing AzerothCore SOAP listener. Keep it loopback-only.
SOAP_URL=http://127.0.0.1:7878/
SOAP_USER=replace_with_soap_service_user
SOAP_PASSWORD=replace_with_soap_service_password

# Private storage. It must not be web-accessible and must be backed up.
ARCHIVE_DIR=/var/lib/heimdall/archive
ARCHIVE_MAX_ATTACHMENT_BYTES=10485760
TRANSCRIPT_RETENTION_DAYS=180
CLOSED_CHANNEL_DELETE_DAYS=7
# Close tickets nobody has touched for this many days. 0 disables it (default).
AUTO_CLOSE_INACTIVE_DAYS=0
# Ping the Game Master role when a ticket has sat unclaimed this many minutes. 0 disables it (default).
QUEUE_NUDGE_MINUTES=0
DELIVERY_LEASE_SECONDS=60
DELIVERY_MAX_ATTEMPTS=12
BOT_INSTANCE_ID=replace_with_unique_instance_name

# --- Logging -------------------------------------------------------------------------------------
# error, warn, info or debug. Default info.
# WARNING: debug records the text of player whispers and ticket messages. Review a debug log before
# sending it to anyone; info and above record only events, identifiers and message sizes.
LOG_LEVEL=info
# Where heimdall-bot.log is written. Defaults to the bot's own directory.
LOG_DIR=.
# Rotate once the file passes this many bytes, keeping this many older files.
LOG_MAX_FILE_BYTES=5242880
LOG_RETAINED_FILES=5
