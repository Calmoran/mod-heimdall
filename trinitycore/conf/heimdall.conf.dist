###################################################################################################
# Heimdall for TrinityCore
#
# Copy this file to worldserver.conf.d/heimdall.conf next to your worldserver.conf, then edit the
# copy. Worldserver reads every .conf file in that directory at startup, so nothing in
# worldserver.conf itself has to be changed.
#
# Three things worth knowing about how this core reads additional config files:
#   - Keep the single [worldserver] section header below. Only the FIRST section of an additional
#     file is read; a second section is silently ignored.
#   - A malformed or empty file stops worldserver from starting, with the reason printed before
#     the log opens ("Error in additional config files"). If the realm will not start after an
#     edit here, that message is where to look.
#   - Save it as plain UTF-8 WITHOUT a byte order mark. Several Windows editors add one silently,
#     and the parser then reports "'=' character not found in line (...heimdall.conf:1)" and the
#     realm does not start.
#
# This build carries the whole bridge except the GM command audit, which this core cannot support
# faithfully - see the end of this file.
###################################################################################################

[worldserver]

# Enable the game-side bridge. Default 0.
Heimdall.Enabled = 0

# The database that holds Heimdall's tables, on the same MySQL server as the realm. The module
# creates the tables there itself on first start; the database and the core's right to use it are
# the one piece of manual SQL (deploy/create-heimdall-database.sql at the repository root, with
# the core's own MySQL account in place of the AzerothCore one it names). The companion bot's
# account is granted this database and nothing else, which is why it must not be a realm database:
# a value equal to the characters database is refused at startup and the bridge stays disabled.
# Letters, digits, _ and $ only, up to 64 characters. Must match MYSQL_DATABASE in the bot's .env.
Heimdall.Database = "heimdall"

# Short tag identifying this realm in ticket keys, 1-16 letters or digits (for example "ARCA",
# giving keys like ARCA-42). Leave blank to derive it from this worldserver's RealmID instead,
# giving keys like R1-42. "DIS" is reserved, because that is how the companion bot labels tickets
# opened from Discord.
#
#        CHOOSE THIS ONCE, AT INSTALL. The tag keys everything - the watermark and every ticket -
#        so changing it later makes the next start a first run under the new tag: open tickets are
#        re-imported with duplicate Discord channels, and their old records are orphaned where the
#        poller never reads them. The worldserver warns at startup when tickets exist under a tag
#        other than the configured one.
#
#        THE TAG MUST BE UNIQUE PER DISCORD GUILD, not merely per database.
Heimdall.RealmPrefix = ""

# What the very first poll on this realm does with the tickets already in gm_ticket:
#   open   import the open ones, leave closed history alone (default)
#   none   import nothing; only tickets filed after this start are bridged
#   all    import everything, including closed history - one Discord channel per ticket
# Only ever consulted when this realm has no watermark yet.
Heimdall.FirstRunImport = "open"

# How often gm_ticket is read, in seconds. Read-only: the module never writes that table.
Heimdall.TicketPollSeconds = 15

# How often queued commands from Discord are picked up, in seconds. This is the whole of the delay
# between a staff member pressing a button and the effect in game, so 1 is the default.
Heimdall.DeliveryPollSeconds = 1

# How many times a command is retried before it is given up on and reported to Discord. Mirrors
# the bot's own limit; both halves fail a job by the same rule.
Heimdall.DeliveryMaxAttempts = 12

# How long a closed ticket's transcript is kept, in days.
Heimdall.ArchiveRetentionDays = 180

# How often the player card behind an open ticket is refreshed, in seconds. Minimum 10.
Heimdall.ContextRefreshSeconds = 15

# The characters Heimdall may log in headlessly and speak as - a comma-separated list of character
# names that exist on this realm. This is a consent list, and it is the only way a name becomes one
# Heimdall will act for: a name arriving from Discord that is not here resolves to no held identity
# and the reply is refused.
#
# Each name must be a real character on this realm. The account behind a name that will CLAIM
# tickets also needs the "be assigned tickets" permission, which security level 1 (Moderator) and
# above have by default - .ticket assign checks the account's RBAC permission, not the character.
#
# Whispering needs no permission at all, which is why a plain account looks healthy right up until
# the first Claim.
#
# Empty by default: with no identity configured, tickets still reach Discord and commands still
# work, but nobody can whisper a player and no identity can be logged in.
Heimdall.GmIdentities = ""

# Whether a whisper from a GM identity carries the client's <GM> badge. On by default: the badge is
# a protocol flag a player character cannot forge, so it is how a player knows the reply is really
# from a Game Master. A server running an in-character support desk can turn it off.
Heimdall.GmChatTag = 1

# The most bytes a single whisper may carry, 32-255.
#
# HONEST NOTE: this setting currently does nothing on either core. The module reads it, clamps it
# and prints it at startup; the splitting of a long reply is done by the companion bot from its own
# constant. It is kept here so both halves have the same configuration shape, and making it do
# something (or removing it from both) is a change that belongs to both cores at once.
Heimdall.MaxWhisperBytes = 240

# NOT AVAILABLE IN THIS RELEASE, and absent rather than present-and-ignored:
#
#   Heimdall.CommandAudit*
#       The AzerothCore module can log every GM command with the Discord user who caused it. Doing
#       that faithfully needs a pre-command hook covering game, console and SOAP alike, which this
#       core does not offer without a third core patch. A switch that produced partial attribution
#       would be worse than none, so there is no switch: on TrinityCore the audit is off, and the
#       release notes say so rather than a config comment implying it can be turned on.

# Heimdall's log category. TrinityCore's stock "root" logger is at level 5 (error), and an
# unconfigured category inherits from it - without this line Heimdall's startup message is
# dropped rather than printed. Level 3 is Info. "Console Server" are the appenders defined in
# worldserver.conf; if you renamed them there, rename them here too.
Logger.heimdall = 3,Console Server
