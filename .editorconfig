root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true
end_of_line = lf

[*.{cpp,h}]
indent_style = space
indent_size = 4

[*.{js,json,yml}]
indent_style = space
indent_size = 2

[*.md]
# Trailing double-spaces are hard line breaks in Markdown.
trim_trailing_whitespace = false
